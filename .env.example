# Copy to .env.local for local development. On Vercel, set these in
# Project Settings > Environment Variables.

# --- Site ---------------------------------------------------------------
# Public URL of the app. Used in sign-in links and emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings > API Keys) -----------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). The legacy anon key also works
# under NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or legacy service_role key. Server only.
# Never prefix with NEXT_PUBLIC_. Bypasses row-level security.
SUPABASE_SECRET_KEY=
# Direct Postgres connection string. Used only by `npm run test:db -- --existing`.
DATABASE_URL=

# --- Auth ---------------------------------------------------------------
# Set to "true" after enabling the Google provider in Supabase Auth.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# --- Stripe (phase 2) ---------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Resend (phase 2) ---------------------------------------------------
RESEND_API_KEY=
# A sender on a domain you've verified in Resend.
EMAIL_FROM="Connestee Crit Series <races@example.com>"
# Where riders' replies go.
EMAIL_REPLY_TO=

# --- Weather (phase 4) --------------------------------------------------
# Open-Meteo needs no key. NWS asks for a contact in the User-Agent.
NWS_USER_AGENT="ConnesteeCritSeries (contact@example.com)"

# --- Scheduled jobs (phase 2+) -----------------------------------------
# Shared secret that Vercel Cron sends to the reminder and waitlist routes.
CRON_SECRET=

# --- Seed script --------------------------------------------------------
# Optional: real inboxes for the seeded admin and staff users, so you can
# sign in as them. Other seeded users get @example.test addresses.
SEED_ADMIN_EMAIL=
SEED_STAFF_EMAIL=

# --- Local SQL tests (npm run test:db) ---------------------------------
# A Postgres 15+ superuser connection for the throwaway test database.
PGHOST=localhost
PGUSER=postgres
PGPASSWORD=
