# Copy to .env.local for local development. On Vercel, set these in
# Project Settings > Environment Variables.

# --- Site ---------------------------------------------------------------
# Public URL of the app. Used in sign-in links and emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings > API Keys) -----------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). The legacy anon key also works
# under NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or legacy service_role key. Server only.
# Never prefix with NEXT_PUBLIC_. Bypasses row-level security.
SUPABASE_SECRET_KEY=
# Direct Postgres connection string. Used only by `npm run test:db -- --existing`.
DATABASE_URL=

# --- Auth ---------------------------------------------------------------
# Set to "true" after enabling the Google provider in Supabase Auth.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# --- Stripe ---------------------------------------------------------
# Secret key (sk_test_... in test mode). Server only.
STRIPE_SECRET_KEY=
# Signing secret for /api/stripe/webhook (whsec_...). From `stripe listen`
# locally, or the webhook endpoint in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=

# --- Resend ---------------------------------------------------------
# Without these, emails are written to the server log instead of sent.
RESEND_API_KEY=
# A sender on a domain you've verified in Resend.
EMAIL_FROM="Connestee Crit Series <races@example.com>"
# Where riders' replies go.
EMAIL_REPLY_TO=

# --- Weather ----------------------------------------------------------
# Open-Meteo needs no key. Override the host only for testing or a
# self-hosted instance.
OPEN_METEO_BASE_URL=
# Optional NWS alerts. NWS asks clients for a name and contact email.
# Leave empty to turn alerts off.
NWS_USER_AGENT=
NWS_BASE_URL=

# --- Scheduled job ----------------------------------------------------
# Bearer token Vercel Cron sends to /api/cron/registrations. Use a long
# random string, for example from `openssl rand -hex 32`.
CRON_SECRET=

# --- Seed script --------------------------------------------------------
# Optional: real inboxes for the seeded admin and staff users, so you can
# sign in as them. Other seeded users get @example.test addresses.
SEED_ADMIN_EMAIL=
SEED_STAFF_EMAIL=

# --- Local SQL tests (npm run test:db) ---------------------------------
# A Postgres 15+ superuser connection for the throwaway test database.
PGHOST=localhost
PGUSER=postgres
PGPASSWORD=
